{
    "$schema": "https://nitro.margelo.com/nitro.schema.json",
    "cxxNamespace": [
        "udp"
    ],
    "ios": {
        "iosModuleName": "RustCUdp"
    },
    "android": {
        "androidNamespace": [
            "udp"
        ],
        "androidCxxLibName": "RustCUdp"
    },
    "autolinking": {
        "UdpDriver": {
            "cpp": "HybridUdpDriver"
        }
    },
    "cxx": {
        "extraIncludeDirs": [
            "./cpp",
            "./rust-bundle/include"
        ],
        "extraLibs": [
            "rust_c_udp"
        ],
        "extraLibDirs": [
            "./mac"
        ]
    },
    "ignorePaths": [
        "**/node_modules"
    ]
}